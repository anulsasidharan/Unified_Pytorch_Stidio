# App
APP_NAME=unified-python-studio
APP_ENV=development
SECRET_KEY=your-secret-key

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/python_studio

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (for AI tutor)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# AWS (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1
S3_BUCKET=python-studio-assets

# Pyodide (CDN version pin)
NEXT_PUBLIC_PYODIDE_VERSION=0.25.0

# ── Docker / local dev (optional overrides) ──────────────
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_URL=http://backend:8000/api/v1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=python_studio
POSTGRES_PORT=5432
REDIS_PORT=6379
RUN_MIGRATIONS=true
SEED_TOPICS=true

# ── Anthropic (legacy tutor — optional) ────────────────
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-4-20250514
